{
  "name": "@arcanemachine/pi-web-search",
  "version": "1.0.0",
  "description": "Bounded web search and static document tools for pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcanemachine/pi-web-search.git"
  },
  "homepage": "https://github.com/arcanemachine/pi-web-search#readme",
  "bugs": {
    "url": "https://github.com/arcanemachine/pi-web-search/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "tsc --noEmit",
    "watch": "tsc --watch --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write index.ts \"src/**/*.ts\" \"test/**/*.ts\" package.json README.md AGENTS.md",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@sinclair/typebox": "^0.34.49",
    "jsdom": "^26.1.0",
    "node-html-markdown": "^2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.3.3",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE.md"
  ]
}
